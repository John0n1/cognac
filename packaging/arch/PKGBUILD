# Maintainer: John Hauger Mitander <john@mitander.io>
pkgname=cognac-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='Intelligent Windows application installer for Linux'
arch=('x86_64')
url='https://github.com/John0n1/cognac'
license=('MIT')
depends=('glibc' 'gcc-libs' 'coreutils' 'tar' 'xz' 'python>=3.10')
provides=('cognac')
conflicts=('cognac')
options=('!debug' '!strip')
source=("cognac-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/cognac-${pkgver}-x86_64.tar.gz")
sha256sums=('5e5b3885a283a2e3d3e1c76f5c6508f7101c107e449bff9534b04b0ae3c1573a')

package() {
  install -Dm755 "${srcdir}/cognac-${pkgver}-x86_64/bin/cognac" \
    "${pkgdir}/usr/bin/cognac"
  install -Dm644 "${srcdir}/cognac-${pkgver}-x86_64/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/cognac-${pkgver}-x86_64/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${srcdir}/cognac-${pkgver}-x86_64/CHANGELOG.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
  cp -R "${srcdir}/cognac-${pkgver}-x86_64/docs" "${pkgdir}/usr/share/doc/${pkgname}/docs"
}
